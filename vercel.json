{
  "functions": {
    "api/generate/index.ts": {
      "maxDuration": 120
    },
    "api/generate/script.ts": {
      "maxDuration": 120
    },
    "api/generate/audio.ts": {
      "maxDuration": 120
    },
    "api/generate/status/[id].ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 30
    },
    "api/topics.ts": {
      "maxDuration": 30
    },
    "api/preferences.ts": {
      "maxDuration": 30
    },
    "api/user-topics.ts": {
      "maxDuration": 30
    },
    "api/episodes/index.ts": {
      "maxDuration": 30
    },
    "api/episodes/today.ts": {
      "maxDuration": 30
    },
    "api/episodes/[id].ts": {
      "maxDuration": 30
    },
    "api/me.ts": {
      "maxDuration": 30
    },
    "api/custom-topics/index.ts": {
      "maxDuration": 30
    },
    "api/custom-topics/[id].ts": {
      "maxDuration": 30
    },
    "api/custom-topics/analyze.ts": {
      "maxDuration": 60
    },
    "api/billing/checkout.ts": {
      "maxDuration": 30
    },
    "api/billing/portal.ts": {
      "maxDuration": 30
    },
    "api/billing/webhook.ts": {
      "maxDuration": 30
    },
    "api/cron/sweep-episodes.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sweep-episodes",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
