{
  "functions": {
    "api/generate-segment.ts": {
      "maxDuration": 60
    },
    "api/voice-sample.ts": {
      "maxDuration": 30
    },
    "api/list-voices.ts": {
      "maxDuration": 15
    },
    "api/build-episode.ts": {
      "maxDuration": 120
    },
    "api/cron/send-digests.ts": {
      "maxDuration": 120
    },
    "api/cron/generate-episodes.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/send-digests",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/cron/generate-episodes",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
