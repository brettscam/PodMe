{
  "functions": {
    "api/generate/index.ts": {
      "maxDuration": 120
    },
    "api/generate/script.ts": {
      "maxDuration": 120
    },
    "api/generate/audio.ts": {
      "maxDuration": 120
    },
    "api/generate/status/[id].ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 30
    },
    "api/topics.ts": {
      "maxDuration": 30
    },
    "api/preferences.ts": {
      "maxDuration": 30
    },
    "api/user-topics.ts": {
      "maxDuration": 30
    },
    "api/episodes/index.ts": {
      "maxDuration": 30
    },
    "api/episodes/[id].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
