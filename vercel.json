{
  "functions": {
    "api/generate-segment.ts": {
      "maxDuration": 60
    },
    "api/voice-sample.ts": {
      "maxDuration": 30
    },
    "api/list-voices.ts": {
      "maxDuration": 15
    },
    "api/build-episode.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
