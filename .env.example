# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (required for episode generation)
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Cron authentication (required for scheduled jobs)
CRON_SECRET=your-random-secret

# Replicate (required for audio generation via Chatterbox TTS)
REPLICATE_API_TOKEN=r8_your-token

# Email delivery (required for digest emails)
RESEND_API_KEY=re_your-key

# Stripe (required for billing)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret

# Stripe price IDs — create products in the Stripe dashboard, paste the price IDs here.
# Naming must stay STRIPE_PRICE_<TIER>_<INTERVAL>; api/lib/stripe.ts resolves them by convention.
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_UNLIMITED_MONTHLY=price_xxx
STRIPE_PRICE_UNLIMITED_YEARLY=price_xxx

# Absolute base URL used for Stripe redirect targets.
# Falls back to VERCEL_URL, then localhost.
APP_URL=https://pod-me.vercel.app
