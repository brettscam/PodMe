# Expo exposes only EXPO_PUBLIC_*-prefixed vars to the client bundle.
# Copy to .env.local and fill in. Never put service-role keys here —
# anything in this file ships inside the app binary.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed web API the app calls for generation, episodes, tiers.
EXPO_PUBLIC_API_URL=https://pod-me.vercel.app
